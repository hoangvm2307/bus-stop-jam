<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <engine:VisualElement name="Background" class="bg-slate-900 absolute size-full justify-center items-center" />
    <engine:Label text="GridView Demo" class="text-5xl" style="-unity-text-align: upper-center;" />
    <engine:VisualElement name="GridView" style="flex-grow: 1;">
        <engine:ListView name="GridViewList" fixed-item-height="200" usage-hints="DynamicTransform" class="size-full" />
    </engine:VisualElement>
</engine:UXML>
