<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="ListViewDemo.uss?fileID=7433441132597879392&amp;guid=97d6107b71b4ba54a99e8900b9bef021&amp;type=3#ListViewDemo" />
    <engine:VisualElement style="flex-grow: 1; align-items: center; justify-content: space-evenly;">
        <engine:VisualElement style="flex-grow: 1; width: 100%;">
            <engine:VisualElement style="flex-grow: 1; flex-direction: row; width: 100%; justify-content: space-evenly;">
                <engine:VisualElement>
                    <engine:Label text="ListView Primary" />
                    <engine:ListView name="ListDefault" fixed-item-height="100" class="primary" />
                </engine:VisualElement>
                <engine:VisualElement>
                    <engine:Label text="ListView Red" />
                    <engine:ListView name="ListRed" fixed-item-height="100" class="red" />
                </engine:VisualElement>
                <engine:VisualElement>
                    <engine:Label text="ListView Ghost" class="ghost" />
                    <engine:ListView name="ListGhost" fixed-item-height="100" class="ghost" />
                </engine:VisualElement>
                <engine:VisualElement>
                    <engine:Label text="ListView Ghost Violet" class="ghost" />
                    <engine:ListView name="ListGhostPurple" fixed-item-height="100" class="violet ghost" />
                </engine:VisualElement>
            </engine:VisualElement>
            <engine:VisualElement style="flex-grow: 1; flex-direction: row; width: 100%; justify-content: space-evenly;">
                <engine:VisualElement>
                    <engine:Label text="ScrollView Primary" />
                    <engine:ScrollView name="ScrollPurple" class="primary" />
                </engine:VisualElement>
                <engine:VisualElement>
                    <engine:Label text="ScrollView Red" />
                    <engine:ScrollView name="ScrollRed" class="red" />
                </engine:VisualElement>
            </engine:VisualElement>
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
