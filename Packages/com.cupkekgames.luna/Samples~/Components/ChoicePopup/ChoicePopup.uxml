<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="ChoicePopup.uss?fileID=7433441132597879392&amp;guid=3b47ee91a27b40b47b30165986d8c682&amp;type=3#ChoicePopup" />
    <ui:VisualElement name="ChoicePopup" class="modal_container" style="display: none;">
        <ui:VisualElement class="modal">
            <ui:VisualElement name="top" class="modal_top">
                <ui:Label text="Question?" display-tooltip-when-elided="true" name="Header" />
            </ui:VisualElement>
            <ui:VisualElement name="middle" class="modal_middle">
                <ui:Label text="Explanation." display-tooltip-when-elided="true" name="Body" />
            </ui:VisualElement>
            <ui:VisualElement name="ButtonContainer" class="modal_bottom" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
