<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="Notification.uss" />
    <ui:Button display-tooltip-when-elided="true" name="DismissButton" class="btn">
        <ui:VisualElement name="Image" picking-mode="Ignore" class="notification_avatar" />
        <ui:VisualElement picking-mode="Ignore" class="notification_text_container">
            <ui:Label text="Label" display-tooltip-when-elided="true" name="Title" picking-mode="Ignore" class="notification_title"/>
            <ui:Label text="Lorem ipsum dolor sit amet" display-tooltip-when-elided="true" name="Body" picking-mode="Ignore" class="notification_body"/>
        </ui:VisualElement>
    </ui:Button>
</ui:UXML>
