<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Packages/com.cupkekgames.luna/Editor/LunaUIWindow.uss?fileID=7433441132597879392&amp;guid=8a8dc90075270f54098c9a7c9f306319&amp;type=3#LunaUIWindow" />
    <engine:ScrollView name="LunaUIScroll">
        <engine:VisualElement name="FirstContainer" style="flex-grow: 1;">
            <engine:VisualElement style="flex-grow: 1; flex-direction: row; justify-content: center; align-items: center; margin-top: 8px; margin-right: 8px; margin-bottom: 8px; margin-left: 8px;">
                <engine:VisualElement style="flex-grow: 1; width: 32px; height: 32px; max-width: 32px; max-height: 32px; min-width: 32px; min-height: 32px; background-image: url(&quot;project://database/Packages/com.cupkekgames.luna/Editor/logo_mini_final.png?fileID=2800000&amp;guid=57be8e6aaaa37634ea8ab6bdf2286b88&amp;type=3#logo_mini_final&quot;); border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px; margin-right: 8px;" />
                <engine:VisualElement>
                    <engine:Label text="Luna UI" style="font-size: 16px; -unity-font-style: bold;" />
                    <engine:Label text="by CupkekGames" style="font-size: 12px;" />
                </engine:VisualElement>
            </engine:VisualElement>
            <engine:VisualElement style="flex-grow: 1; flex-direction: row; align-items: center; margin-top: 8px; margin-bottom: 8px;">
                <engine:Label text="Documentation: " style="-unity-font-style: bold; font-size: 16px;" />
                <engine:Button text="Open Url" icon-image="project://database/Packages/com.cupkekgames.luna/Editor/share1.png?fileID=2800000&amp;guid=9791ca73313d53840be5a215fb54a154&amp;type=3#share1" name="OpenUrlDocs" />
            </engine:VisualElement>
            <engine:Label text="Requirements" style="-unity-font-style: bold;" />
        </engine:VisualElement>
        <engine:VisualElement style="flex-grow: 1; margin-bottom: 8px; margin-top: 8px;">
            <engine:Label text="Samples" style="-unity-text-align: middle-center; -unity-font-style: bold; color: rgb(255, 255, 255); font-size: 20px;" />
            <engine:Label text="You can import samples from Package Manager." style="color: rgb(255, 255, 255);" />
        </engine:VisualElement>
    </engine:ScrollView>
</engine:UXML>
