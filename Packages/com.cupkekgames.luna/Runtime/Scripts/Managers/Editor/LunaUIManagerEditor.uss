Label {
    white-space: normal;
    font-size: 12px;
    color: white;
}

.icon_checkmark {
    background-image: url("project://database/Packages/com.cupkekgames.luna/Editor/checkmark.png?fileID=21300000&guid=096a9a613101c334da8df6090a8db808&type=3#checkmark");
    -unity-background-image-tint-color: rgb(73, 204, 91);
}

.icon_cross {
    background-image: url("project://database/Packages/com.cupkekgames.luna/Editor/cross.png?fileID=21300000&guid=0c34bac7e8e5ba344bda980c1d46fec0&type=3#cross");
    -unity-background-image-tint-color: rgb(204, 74, 74);
}

.odd_line {
}

.even_line {
    background-color: rgba(0, 0, 0, 0.25);
}

#OpenUrlDocs {
    flex-direction: row-reverse;
    max-height: 32px;
}

#OpenUrlDocs > Image {
    max-width: 20px;
    max-height: 20px;
    width: 20px;
    height: 20px;
}

.unity-foldout__toggle--inspector {
    margin-left: 4px;
}

.page {
    border-radius: 8px; 
    --border-color: rgba(255, 255, 255, 0.5);
}

.container {
    border-color: var(--border-color);
    border-width: 1px; 
    border-radius: 8px; 
    padding: 8px;
    margin-bottom: 16px;
}

.section {
    padding-bottom: 32px;
    border-bottom-width: 1px;
    border-color: var(--border-color);
}

.section.last {
    border-bottom-width: 0;
    padding-bottom: 8px;
}

.title {
    -unity-text-align: middle-center; 
    -unity-font-style: bold; 
    color: rgb(255, 255, 255); 
    font-size: 20px; 
    border-bottom-width: 1px;
    border-color: var(--border-color);
    padding-bottom: 8px;
}

.subtitle {
    -unity-text-align: middle-center; 
    -unity-font-style: italic; 
    color: rgb(255, 255, 255); 
    font-size: 14px; 
    margin-top: 8px;
    margin-bottom: 8px;
}

.description {
    -unity-text-align: middle-left;
    color: rgb(255, 255, 255); 
    background-color: rgba(0, 0, 0, 0.32);
    font-size: 12px; 
    padding: 8px;
    border-radius: 8px;
    margin-bottom: 8px;
}
