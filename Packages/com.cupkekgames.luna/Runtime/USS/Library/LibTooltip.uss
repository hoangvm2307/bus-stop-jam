.tooltip_container {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.backdrop {
  --backdrop-color: rgba(0, 0, 0, 0.5);
}

.backdrop {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  background-color: var(--backdrop-color);
  border-width: 0;
}

/* Remove hover/focus scaling */
.backdrop:hover,
.backdrop:focus {
  scale: 1;
  border-width: 0;
}

/* Remove active state */
.backdrop:active {
  scale: 1;
  border-width: 0;
}

/* Remove disabled state */
.backdrop:disabled,
.backdrop:disabled:hover {
  opacity: 1;
  scale: 1;
  border-color: transparent;
  background-color: transparent;
  border-width: 0;
}

.backdrop:hover:enabled {
  background-color: var(--backdrop-color);
}

.backdrop:focus:enabled {
  background-color: var(--backdrop-color);
}

.lockingProgressBar {
  height: 100%;
  --radial-progress-bg-color: var(--color-neutral-50);
  --radial-progress-progress-color: var(--color-primary-600);
  --radial-progress-indicator-positive-color: var(--color-neutral-900);
  --radial-progress-indicator-negative-color: var(--color-neutral-900);
}