.ProgressBar {
  height: var(--length-64);
  width: var(--length-448);
  flex-direction: row-reverse;
  align-items: center;
}

.ProgressBar__icon {
  border-radius: var(--length-8);
  margin-right: var(--length-2);
}

.ProgressBar__background {
  flex: 1;
  border-radius: var(--length-8);
  height: 100%;
}

.ProgressBar__progress-container {
  flex: 1;
  justify-content: center;
  flex-direction: row;
  border-radius: var(--length-8);
  overflow: hidden;
  background-repeat: repeat-x;
  background-position-x: left 0px;
  background-position-y: top 0px;
}

.ProgressBar__progress-elements-container {
  position: absolute;
  width: 100%;
  height: 100%;
}

.ProgressBar__progress-element {
  position: absolute;
  height: 100%;
}

.ProgressBar__change-indicator {
  position: absolute;
  left: 0;
  width: 100%;
  height: 100%;
}

.ProgressBar__progress-vertical-line {
  position: absolute;
  right: 0;
  top: -20%;
  width: var(--length-16);
  height: 140%;
  border-radius: var(--length-8);
  background-color: white;
}

.ProgressBar__title-container {
  position: absolute;
  width: 100%;
  height: 100%;
  flex: 1;
}

.ProgressBar__title {
  color: rgb(255, 255, 255);
  flex: 1;
  -unity-text-align: middle-center;
  -unity-font-definition: var(--font-bold);
  font-size: var(--length-32);
}

.ProgressBar__overlay {
  position: absolute;
  width: 100%;
  height: 100%;
  flex-direction: row;
}

.ProgressBar.primary {
    --progress-bar-bg-color: var(--color-base-700);
    --progress-bar-progress-color-0: var(--color-primary-600);
    --progress-bar-indicator-positive-color: var(--color-primary-300);
    --progress-bar-indicator-negative-color: var(--color-red-400);
}

