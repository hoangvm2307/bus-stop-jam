.radial-progress.primary {
    --radial-progress-bg-color: var(--color-base-700);
    --radial-progress-progress-color: var(--color-primary-600);
    --radial-progress-indicator-positive-color: var(--color-primary-300);
    --radial-progress-indicator-negative-color: var(--color-red-400);
}

