.unity-toggle.rose > .unity-toggle__input:hover:enabled:checked > .unity-toggle__checkmark {
  border-color: var(--color-rose-200);
}

.unity-base-field.rose:focus:enabled > .unity-base-field__label {
  color: var(--color-rose-400);
}
  