    border-bottom-left-radius: var(--length-4);
    border-bottom-right-radius: var(--length-4);
    -unity-background-image-tint-color: var(--color-slate-400);
}

.unity-scroller--horizontal .unity-scroller__high-button {
    border-bottom-left-radius: 0;
    border-bottom-right-radius: var(--length-4);
    border-top-right-radius: var(--length-4);
}

