.btn {
  flex-direction: row;
  justify-content: center;
  align-items: center;
  border-color: transparent;
  scale: 1;
  transition-duration: 0.2s;
  transition-property: scale;
  -unity-slice-scale: 8px;
  -unity-slice-left: 1;
  -unity-slice-top: 1;
  -unity-slice-right: 1;
  -unity-slice-bottom: 1;
}

.btn,
.btn > * {
  color: white;
}

.btn,
.btn * {
  cursor: var(--cursor-pointer);
}

.btn:disabled,
.btn:disabled * {
  cursor: var(--cursor-not-allowed);
}

.btn:hover,
.btn:focus {
  scale: 1.05;
}

.btn > * {
  color: white;
}

.btn:hover,
.btn:focus {
  color: white;
}

.btn:hover > *,
.btn:focus > * {
  color: white;
}

.btn:active {
  color: white;
  scale: 1;
}

.btn:active > * {
  color: white;
}

.btn:disabled,
.btn:disabled:hover {
  opacity: 1;
  scale: 1;
  border-color: var(--color-slate-800);
  background-color: var(--color-slate-800);
  color: var(--color-slate-500);
}

.btn:disabled > *,
.btn:disabled:hover > * {
  color: var(--color-slate-500);
  -unity-background-image-tint-color: var(--color-slate-500);
}

.btn {
  font-size: var(--length-28);
  border-radius: var(--length-12);
  padding-top: var(--length-8);
  padding-bottom: var(--length-8);
  padding-left: var(--length-12);
  padding-right: var(--length-12);
  max-height: var(--length-64);
  min-height: var(--length-64);
  min-width: var(--length-64);
  border-width: var(--length-6);
}

.btn > * {
  font-size: var(--length-28);
}

.btn-sm {
  font-size: var(--length-24);
  border-radius: var(--length-8);
  padding-top: var(--length-4);
  padding-bottom: var(--length-4);
  padding-left: var(--length-8);
  padding-right: var(--length-8);
  max-height: var(--length-48);
  min-height: var(--length-48);
  min-width: var(--length-48);
  border-width: var(--length-4);
}

.btn-sm > * {
  font-size: var(--length-24);
}

.btn-lg {
  font-size: var(--length-32);
  border-radius: var(--length-16);
  padding-top: var(--length-12);
  padding-bottom: var(--length-12);
  padding-left: var(--length-16);
  padding-right: var(--length-16);
  max-height: var(--length-80);
  min-height: var(--length-80);
  min-width: var(--length-80);
  border-width: var(--length-8);
}

.btn-lg > * {
  font-size: var(--length-32);
}

.btn-xl {
  font-size: var(--length-36);
  border-radius: var(--length-20);
  padding-top: var(--length-16);
  padding-bottom: var(--length-16);
  padding-left: var(--length-20);
  padding-right: var(--length-20);
  max-height: var(--length-96);
  min-height: var(--length-96);
  min-width: var(--length-96);
  border-width: var(--length-10);
}

.btn-xl > * {
  font-size: var(--length-36);
}

.btn {
  background-color: var(--color-slate-600);
}

.btn:hover,
.btn:focus,
.btn:hover:enabled,
.btn:focus:enabled {
  border-color: transparent;
  background-color: var(--color-slate-400);
}

.btn:disabled:hover {
  border-color: var(--color-slate-800);
  background-color: var(--color-slate-800);
  color: var(--color-slate-500);
}

.btn:focus,
.btn:focus:enabled {
  border-color: var(--color-slate-200);
}

