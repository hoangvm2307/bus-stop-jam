.unity-tab-view {
  width: 100%;
}

.unity-tab-view__header-container {
  justify-content: center;
  padding: var(--length-16);
}

.unity-tab-view__header-container > * {
  margin: 0;
  margin-left: var(--length-8);
  margin-right: var(--length-8);
}

.unity-tab__header,
.unity-tab__header * {
  cursor: var(--cursor-pointer);
}

.unity-tab__header:disabled,
.unity-tab__header:disabled * {
  cursor: var(--cursor-not-allowed);
}

.unity-tab__header {
  flex: 1;
  background-color: transparent;
  -unity-text-align: upper-center;
  justify-content: center;
  background-color: transparent;
  padding: var(--length-4);
  border-width: var(--length-4);
  background-color: var(--color-slate-600);
  border-radius: var(--length-8);
  padding-left: var(--length-16);
  padding-right: var(--length-16);
  padding-top: var(--length-8);
  padding-bottom: var(--length-8);
}

.unity-tab__header:hover,
.unity-tab__header:focus {
  background-color: var(--color-slate-400);
}

.unity-tab__header:checked {
  background-color: var(--color-primary-400);
}

.unity-tab__header:checked:hover,
.unity-tab__header:checked:focus {
}

.unity-tab__header-underline {
  display: none;
}

.unity-tab__header:checked > .unity-tab__header-underline {
  background-color: var(--color-primary-200);
  height: var(--length-8);
}

.unity-tab__header > .unity-tab__header-label {
  -unity-font-definition: var(--font-bold);
  flex: 1;
}

.unity-tab__content-container {
  flex: 1;
}

.unity-tab {
  flex: 1;
}

.tab-view-vertical {
  flex-direction: row;
}

.tab-view-vertical .unity-tab-view__header-container {
  flex-direction: column;
}

.tab-view-vertical .unity-tab-view__header-container > * {
  margin: 0;
  margin-top: var(--length-8);
  margin-bottom: var(--length-8);
}

.tab-view-vertical {
  flex-direction: row;
}

.tab-view-vertical .unity-tab__header {
  width: 100%;
  max-height: var(--length-80);
}

.unity-tab__header > .unity-tab__header-image {
  height: var(--length-48);
  width: var(--length-48);
}

.unity-tab-view.inactive-base .unity-tab__header {
  background-color: var(--color-base-600);
}
.unity-tab-view.inactive-base .unity-tab__header:hover,.unity-tab__header:focus {
  background-color: var(--color-base-400);
}

.unity-tab-view.inactive-primary .unity-tab__header {
  background-color: var(--color-primary-600);
}
.unity-tab-view.inactive-primary .unity-tab__header:hover,.unity-tab__header:focus {
  background-color: var(--color-primary-400);
}

.unity-tab-view.inactive-secondary .unity-tab__header {
