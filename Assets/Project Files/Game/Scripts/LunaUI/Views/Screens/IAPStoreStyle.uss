/* =================================
   IAP Store Styling - Component Based
   ================================= */

/* === ROOT CONTAINER === */
.store {
    background-image: url("project://database/Assets/Project%20Files/Game/Images/Base/Store/background_gradient_store.png?fileID=2800000&guid=bcb3485bc794e8040b3f9475cb8f8c7d&type=3#background_gradient_store");
    flex-direction: column;
    justify-content: space-around;
    align-items: flex-start;
    flex-grow: 1;
    height: 100%;
}

/* === HEADER SECTION === */
.store__header {
    height: 281px;
    align-items: stretch;
    justify-content: flex-start;
    width: 100%;
}

.store__header-content {
    flex-grow: 0;
    flex-direction: row;
    height: 144px;
}

.store__blinder {
    flex-grow: 1;
    background-image: url("project://database/Assets/Project%20Files/Game/Images/Base/Store/blinder.png?fileID=21300000&guid=0d0fb6d7da994b54299587e00a2aca22&type=3#blinder");
    min-height: 0;
    height: 167px;
}

.store__title {
    position: absolute;
    top: -28px;
    left: 33%;
    right: 33%;
    -unity-text-align: upper-center;
    -unity-font-definition: url("project://database/Assets/Project%20Files/Game/Fonts/FredokaOne/FredokaOne.ttf?fileID=12800000&guid=10a77611699281f4ead51d19d2036adf&type=3#FredokaOne");
    color: rgb(255, 255, 255);
    font-size: 50px;
    background-image: url("project://database/Assets/Project%20Files/Game/Images/Base/Store/header_orange.png?fileID=21300000&guid=9d5494aa6d724994cb89b4e7ea28e6ba&type=3#header_orange");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-type: sliced;
    -unity-slice-left: 80;
    -unity-slice-top: 80;
    -unity-slice-right: 80;
    -unity-slice-bottom: 80;
    -unity-slice-scale: 0.3px;
    background-repeat: no-repeat;
    height: auto;
}

.store__close-button {
    background-image: url("project://database/Assets/Project%20Files/Game/Images/Base/General%20UI/btn_close.png?fileID=2800000&guid=8eb84762d00580348ad4e5586eef66f2&type=3#btn_close");
    background-color: rgba(188, 188, 188, 0);
    position: absolute;
    top: -16px;
    right: 16px;
    min-width: 80px;
    min-height: 80px;
    border-width: 0;
}

/* === CURRENCY DISPLAY === */
.currency-display {
    flex-direction: row;
    justify-content: flex-end;
    padding-top: 10px;
    padding-bottom: 10px;
    margin-bottom: 8px;
    flex-grow: 0;
    height: 82px;
}

.currency-display__label {
    padding-right: 75px;
    -unity-font-definition: url("project://database/Assets/Project%20Files/Game/Fonts/FredokaOne/FredokaOne.ttf?fileID=12800000&guid=10a77611699281f4ead51d19d2036adf&type=3#FredokaOne");
    padding-left: 24px;
    -unity-text-align: middle-left;
    font-size: 32px;
    height: 50px;
    width: 168px;
    background-color: rgb(255, 255, 255);
    color: rgb(24, 24, 24);
    border-radius: 20px;
    margin-right: 12px;
}

.currency-display__icon {
    background-image: url("project://database/Assets/Project%20Files/Game/Images/Base/Currency/coin.png?fileID=2800000&guid=66be956892120a84bbda15b783d05267&type=3#coin");
    left: -50px;
    position: absolute;
    top: -9px;
    width: 70px;
    height: 70px;
}

/* === STORE BODY === */
.store__body {
    height: 100%;
    flex-grow: 1;
    padding: 10px 20px;
    width: 100%;
    margin: 0;
}

/* === STORE PANELS === */
.store-panel {
    margin: 8px 0;
    padding: 20px;
    min-height: 300px;
    -unity-slice-left: 80;
    -unity-slice-top: 80;
    -unity-slice-right: 80;
    -unity-slice-bottom: 80;
    -unity-slice-scale: 0.5px;
}

.store-panel--blue {
    background-image: url("project://database/Assets/Project%20Files/Game/Images/Base/Store/panel_blue_store.png?fileID=21300000&guid=3249f9e2f5b69e1478a31b9d203a411b&type=3#panel_blue_store");
}

.store-panel--purple {
    background-image: url("project://database/Assets/Project%20Files/Game/Images/Base/Store/panel_purple_store.png?fileID=21300000&guid=afcb18a24c52f8f40806fdf76c55c929&type=3#panel_purple_store");
}

.store-panel--red-white {
    background-image: url("project://database/Assets/Project%20Files/Game/Images/Base/Store/panel_red_white.png?fileID=21300000&guid=26d17f4f00399d04f9248fa4dd3387e2&type=3#panel_red_white");
}

.store-panel--green {
    background-image: url("project://database/Assets/Project%20Files/Game/Images/Base/Store/panel_blue_store.png?fileID=21300000&guid=3249f9e2f5b69e1478a31b9d203a411b&type=3#panel_blue_store");
    opacity: 0.9;
}

.store-panel__items-container {
    flex-direction: row;
    align-items: stretch;
    width: 100%;
    flex-grow: 1;
    min-height: 100px;
    justify-content: space-evenly;
    -unity-background-scale-mode: stretch-to-fill;
}

.store-panel__footer {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 10px;
}

.store-panel__title {
    -unity-font-definition: url("project://database/Assets/Project%20Files/Game/Fonts/FredokaOne/FredokaOne.ttf?fileID=12800000&guid=10a77611699281f4ead51d19d2036adf&type=3#FredokaOne");
    flex-grow: 0;
    font-size: 42px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
}

.store-panel__title--small {
    font-size: 32px;
    color: rgb(87, 87, 87);
}

.store-panel__button {
    background-image: url("project://database/Assets/Project%20Files/Game/Images/Base/General%20UI/btn_green.png?fileID=21300000&guid=707f4a8cd16084649b85184ef96d4c21&type=3#btn_green");
    background-color: rgba(255, 255, 255, 0);
    border-width: 0;
    padding: 12px 20px;
    min-width: 100px;
    min-height: 50px;
    -unity-slice-left: 58;
    -unity-slice-top: 58;
    -unity-slice-right: 50;
    -unity-slice-bottom: 76;
    -unity-slice-scale: 0.5px;
}

.store-panel__button-text {
    -unity-font-definition: url("project://database/Assets/Project%20Files/Game/Fonts/FredokaOne/FredokaOne.ttf?fileID=12800000&guid=10a77611699281f4ead51d19d2036adf&type=3#FredokaOne");
    color: rgb(255, 255, 255);
    font-size: 32px;
}

/* === COIN PACKS SECTION === */
.coin-packs {
    margin: 12px 0;
    min-height: 280px;
}

.coin-packs__title {
    -unity-font-definition: url("project://database/Assets/Project%20Files/Game/Fonts/FredokaOne/FredokaOne.ttf?fileID=12800000&guid=10a77611699281f4ead51d19d2036adf&type=3#FredokaOne");
    font-size: 38px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    margin-bottom: 15px;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
}

.coin-packs__grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: stretch;
    width: 100%;
}

.coin-pack {
    width: 48%;
    margin: 1%;
    padding: 15px;
    min-height: 120px;
    border-radius: 12px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.3);
    justify-content: space-between;
    align-items: center;
    flex-direction: column;
}

.coin-pack--small {
    background-color: rgba(52, 152, 219, 0.8);
}

.coin-pack--medium {
    background-color: rgba(142, 68, 173, 0.8);
}

.coin-pack--large {
    background-color: rgba(231, 76, 60, 0.8);
}

.coin-pack--free {
    background-color: rgba(46, 204, 113, 0.8);
    border-color: rgba(39, 174, 96, 0.8);
}

.coin-pack--ad {
    background-color: rgba(241, 196, 15, 0.8);
    border-color: rgba(243, 156, 18, 0.8);
}

.coin-pack__header {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 8px;
}

.coin-pack__icon {
    width: 40px;
    height: 40px;
    background-image: url("project://database/Assets/Project%20Files/Game/Images/Base/Currency/coin.png?fileID=2800000&guid=66be956892120a84bbda15b783d05267&type=3#coin");
    -unity-background-scale-mode: scale-to-fit;
    margin-right: 8px;
}

.coin-pack__amount {
    -unity-font-definition: url("project://database/Assets/Project%20Files/Game/Fonts/FredokaOne/FredokaOne.ttf?fileID=12800000&guid=10a77611699281f4ead51d19d2036adf&type=3#FredokaOne");
    font-size: 24px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
}

.coin-pack__button {
    background-image: url("project://database/Assets/Project%20Files/Game/Images/Base/General%20UI/btn_green.png?fileID=21300000&guid=707f4a8cd16084649b85184ef96d4c21&type=3#btn_green");
    background-color: rgba(255, 255, 255, 0);
    border-width: 0;
    padding: 8px 16px;
    min-width: 80px;
    min-height: 35px;
    -unity-slice-left: 58;
    -unity-slice-top: 58;
    -unity-slice-right: 50;
    -unity-slice-bottom: 76;
    -unity-slice-scale: 0.3px;
}

.coin-pack__button-text {
    -unity-font-definition: url("project://database/Assets/Project%20Files/Game/Fonts/FredokaOne/FredokaOne.ttf?fileID=12800000&guid=10a77611699281f4ead51d19d2036adf&type=3#FredokaOne");
    color: rgb(255, 255, 255);
    font-size: 18px;
    -unity-text-align: middle-center;
}

.coin-pack__button--free {
    background-image: url("project://database/Assets/Project%20Files/Game/Images/Base/General%20UI/btn_green.png?fileID=21300000&guid=707f4a8cd16084649b85184ef96d4c21&type=3#btn_green");
}

.coin-pack__button--ad {
    background-image: url("project://database/Assets/Project%20Files/Game/Images/Base/General%20UI/btn_green.png?fileID=21300000&guid=707f4a8cd16084649b85184ef96d4c21&type=3#btn_green");
}

.coin-pack__badge {
    position: absolute;
    top: -5px;
    right: 5px;
    padding: 2px 8px;
    background-color: rgba(231, 76, 60, 0.9);
    border-radius: 10px;
    -unity-font-definition: url("project://database/Assets/Project%20Files/Game/Fonts/FredokaOne/FredokaOne.ttf?fileID=12800000&guid=10a77611699281f4ead51d19d2036adf&type=3#FredokaOne");
    font-size: 12px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
}

/* === ITEM DISPLAYS === */
.item-display {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    min-height: 120px;
    margin: 5px 0;
    width: auto;
    height: auto;
}

.item-display--large {
    flex-direction: row;
    width: 567px;
    justify-content: flex-start;
    align-items: stretch;
    align-self: center;
    flex-shrink: 0;
}

.item-display__icon {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.item-display__icon--large {
    width: 288px;
    height: 100%;
    flex-grow: 0;
    flex-shrink: 0;
    align-self: stretch;
}

.item-display__badge {
    background-image: url("project://database/Assets/Project%20Files/Game/Images/Base/Store/badge_orange.png?fileID=2800000&guid=e5e73549c2718684c9b04dd4e86eb951&type=3#badge_orange");
    -unity-font-definition: url("project://database/Assets/Project%20Files/Game/Fonts/FredokaOne/FredokaOne.ttf?fileID=12800000&guid=10a77611699281f4ead51d19d2036adf&type=3#FredokaOne");
    font-size: 24px;
    position: absolute;
    bottom: 0;
    left: 25%;
    right: 25%;
    -unity-text-align: middle-center;
    color: rgb(160, 82, 45);
    padding: 2px 6px;
}

/* === ITEM ICON VARIANTS === */
.item-display__icon--no-ads {
    background-image: url("project://database/Assets/Project%20Files/Game/Images/Base/General%20UI/no_ads.png?fileID=2800000&guid=e9da7f14e336254428efd41f37278ab9&type=3#no_ads");
}

.item-display__icon--hearts {
    background-image: url("project://database/Assets/Project%20Files/Game/Images/Base/General%20UI/heart.png?fileID=21300000&guid=c30e696c126969e4a9d020b50ee8fc24&type=3#heart");
}

.item-display__icon--coins {
    background-image: url("project://database/Assets/Project%20Files/Game/Images/Base/Store/ic_coins_pack_3.png?fileID=21300000&guid=8453a3416047bb447add08ac5ce7be02&type=3#ic_coins_pack_3");
}

.item-display__icon--hint {
    background-image: url("project://database/Assets/Project%20Files/Game/Images/PowerUps/pu_hint.png?fileID=21300000&guid=8d897474d50966f4797ea6072db7c1a0&type=3#pu_hint");
}

.item-display__icon--shuffle {
    background-image: url("project://database/Assets/Project%20Files/Game/Images/PowerUps/pu_shuffle.png?fileID=21300000&guid=bc05c9e359644804ea39b33fdcf4cbb3&type=3#pu_shuffle");
}

.item-display__icon--undo {
    background-image: url("project://database/Assets/Project%20Files/Game/Images/PowerUps/pu_undo.png?fileID=21300000&guid=a323e3679e7ff1145b4828972d86518d&type=3#pu_undo");
}

/* === NO ADS PANEL SPECIFIC === */
.no-ads-panel__content {
    flex-direction: row;
    align-items: center;
    justify-content: space-evenly;
    flex-grow: 1;
    padding: 10px;
}

.no-ads-panel__button {
    background-color: rgba(188, 188, 188, 0);
    align-self: flex-end;
}
