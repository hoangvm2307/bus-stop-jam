<engine:UXML xmlns:engine="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Project%20Files/Game/Scripts/LunaUI/Views/Screens/IAPStoreStyle.uss?fileID=7433441132597879392&amp;guid=68eb58faaaa437441a35a48f1cc9d930&amp;type=3#IAPStoreStyle" />
    
    <!-- Main Store Container -->
    <engine:VisualElement name="store-container" class="store">
        
        <!-- Header Section -->
        <engine:VisualElement name="header" class="store__header">
            
            <!-- Currency Display -->
            <engine:VisualElement name="currency-display" class="currency-display">
                <engine:Label text="60" name="currency-label" class="currency-display__label">
                    <engine:VisualElement name="currency-icon" class="currency-display__icon" />
                </engine:Label>
            </engine:VisualElement>
            
            <!-- Header Content -->
            <engine:VisualElement class="store__header-content">
                <engine:VisualElement name="blinder" class="store__blinder" />
                <engine:Label text="STORE" class="store__title" />
                <engine:Button name="close-button" class="store__close-button" />
            </engine:VisualElement>
            
        </engine:VisualElement>
        
        <!-- Store Body with Scroll -->
        <engine:ScrollView name="ScrollView" class="store__body">
            
            <!-- Starter Pack Panel -->
            <engine:VisualElement name="starter-pack" class="store-panel store-panel--blue">
                
                <!-- Items Container -->
                <engine:VisualElement name="items" class="store-panel__items-container">
                    
                    <!-- No Ads Item -->
                    <engine:VisualElement class="item-display">
                        <engine:VisualElement name="icon-no-ads" class="item-display__icon item-display__icon--no-ads" />
                    </engine:VisualElement>
                    
                    <!-- Shuffle Item -->
                    <engine:VisualElement class="item-display">
                        <engine:VisualElement name="icon-shuffle" class="item-display__icon item-display__icon--shuffle" />
                        <engine:Label text="x5" class="item-display__badge" />
                    </engine:VisualElement>
                    
                    <!-- Hearts Item -->
                    <engine:VisualElement class="item-display">
                        <engine:VisualElement name="icon-hearts" class="item-display__icon item-display__icon--hearts" />
                        <engine:Label text="2hrs" class="item-display__badge" />
                    </engine:VisualElement>
                    
                    <!-- Coins Item -->
                    <engine:VisualElement class="item-display">
                        <engine:VisualElement name="icon-coins" class="item-display__icon item-display__icon--coins" />
                        <engine:Label text="x400" class="item-display__badge" />
                    </engine:VisualElement>
                    
                </engine:VisualElement>
                
                <!-- Panel Footer -->
                <engine:VisualElement class="store-panel__footer">
                    <engine:Label text="STARTER PACK" class="store-panel__title" />
                    <engine:Button name="buy-starter-pack" class="store-panel__button">
                        <engine:Label text="USD 0.00" class="store-panel__button-text" />
                    </engine:Button>
                </engine:VisualElement>
                
            </engine:VisualElement>
            
            <!-- Power Pack Panel -->
            <engine:VisualElement name="power-pack" class="store-panel store-panel--purple">
                
                <!-- Items Container -->
                <engine:VisualElement name="items" class="store-panel__items-container">
                    
                    <!-- Hint Item -->
                    <engine:VisualElement class="item-display">
                        <engine:VisualElement name="icon-hint" class="item-display__icon item-display__icon--hint" />
                        <engine:Label text="x5" class="item-display__badge" />
                    </engine:VisualElement>
                    
                    <!-- Shuffle Item -->
                    <engine:VisualElement class="item-display">
                        <engine:VisualElement name="icon-shuffle" class="item-display__icon item-display__icon--shuffle" />
                        <engine:Label text="x5" class="item-display__badge" />
                    </engine:VisualElement>
                    
                    <!-- Undo Item -->
                    <engine:VisualElement class="item-display">
                        <engine:VisualElement name="icon-undo" class="item-display__icon item-display__icon--undo" />
                        <engine:Label text="x5" class="item-display__badge" />
                    </engine:VisualElement>
                    
                </engine:VisualElement>
                
                <!-- Panel Footer -->
                <engine:VisualElement class="store-panel__footer">
                    <engine:Label text="POWER PACK" class="store-panel__title" />
                    <engine:Button name="buy-power-pack" class="store-panel__button">
                        <engine:Label text="USD 0.00" class="store-panel__button-text" />
                    </engine:Button>
                </engine:VisualElement>
                
            </engine:VisualElement>
            
            <!-- No Ads Pack Panel -->
            <engine:VisualElement name="no-ads-pack" class="store-panel store-panel--red-white">
                
                <!-- No Ads Content -->
                <engine:VisualElement class="no-ads-panel__content">
                    
                    <!-- No Ads Item Large -->
                    <engine:VisualElement class="item-display item-display--large">
                        <engine:VisualElement name="icon-no-ads" class="item-display__icon item-display__icon--no-ads item-display__icon--large" />
                        <engine:Label text="NO ADS" class="store-panel__title store-panel__title--small" />
                    </engine:VisualElement>
                    
                    <!-- Purchase Button -->
                    <engine:Button name="buy-no-ads" class="store-panel__button no-ads-panel__button">
                        <engine:Label text="USD 0.00" class="store-panel__button-text" />
                    </engine:Button>
                    
                </engine:VisualElement>
                
            </engine:VisualElement>
            
        </engine:ScrollView>
        
    </engine:VisualElement>
</engine:UXML>
