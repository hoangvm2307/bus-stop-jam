<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <engine:VisualElement style="flex-grow: 1; align-items: center; justify-content: space-evenly; flex-direction: row;">
        <engine:VisualElement style="flex-grow: 1; align-items: center;">
            <engine:Slider label="Slider" value="42" high-value="100" show-input-field="true" inverted="false" style="width: 100%;" />
        </engine:VisualElement>
        <engine:VisualElement style="flex-grow: 1; align-items: center;">
            <engine:SliderInt label="SliderInt" value="42" high-value="100" show-input-field="true" style="width: 100%;" />
        </engine:VisualElement>
        <engine:VisualElement style="flex-grow: 1; align-items: center;">
            <engine:MinMaxSlider label="Min/Max Slider" value="10,12" low-limit="-10" high-limit="40" style="width: 100%;" />
        </engine:VisualElement>
        <engine:TextField label="Text Field" placeholder-text="filler text" />
    </engine:VisualElement>
    <engine:VisualElement style="flex-grow: 1; align-items: center; justify-content: space-evenly; flex-direction: row;">
        <engine:VisualElement style="flex-grow: 1; align-items: center;">
            <engine:Slider label="Slider" value="42" high-value="100" show-input-field="true" inverted="false" class="light" style="width: 100%;" />
        </engine:VisualElement>
        <engine:VisualElement style="flex-grow: 1; align-items: center;">
            <engine:SliderInt label="SliderInt" value="42" high-value="100" show-input-field="true" class="light" style="width: 100%;" />
        </engine:VisualElement>
        <engine:VisualElement style="flex-grow: 1; align-items: center;">
            <engine:MinMaxSlider label="Min/Max Slider" value="10,12" low-limit="-10" high-limit="40" class="light" style="width: 100%;" />
        </engine:VisualElement>
        <engine:TextField label="Text Field" placeholder-text="filler text" class="light" />
    </engine:VisualElement>
</engine:UXML>
