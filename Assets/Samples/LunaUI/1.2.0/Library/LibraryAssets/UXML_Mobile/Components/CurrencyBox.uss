.currency-box {
    background-color: var(--color-slate-800);
    border-color: var(--color-slate-900);
    border-width: var(--length-4);
    border-radius: var(--length-16);
}

.currency-box .icon {
    flex: 1;
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
    scale: 1.5;
}

.currency-box Label {
    -unity-text-align: middle-right;
    font-size: var(--length-40);
    -unity-font-definition: var(--font-bold);
    color: var(--color-neutral-50);
}

.energy .currency-box .icon {
    background-image: url("../../Sprites/mobile/currency/energy.png");
}

.gold .currency-box .icon {
    background-image: url("../../Sprites/mobile/currency/gold.png");
}

.gem .currency-box .icon {
    background-image: url("../../Sprites/mobile/currency/gem.png");
}


