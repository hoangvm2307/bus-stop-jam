.modal_container {
  width: 100%;
  height: 100%;
  justify-content: center;
  align-items: center;
  position: absolute;
  background-color: rgba(0, 0, 0, 0.9);
}

.modal {
  width: 80%;
  height: 48%;
  background-color: var(--color-indigo-950);
  border-width: var(--length-8);
  border-color: var(--color-indigo-200);
  border-radius: var(--length-32);
  padding: var(--length-32);
    transition-timing-function: ease-out-back;
    transition-duration: 0.6s;
    transition-property: scale;
    scale: 0;
}

.modal.visible {
    scale: 1;
}

.modal_top {
  justify-content: center;
  align-items: center;
  flex: 1;
}

.modal_item {
  justify-content: center;
  align-items: center;
  flex: 3;
  margin-top: var(--length-32);
}

.modal_middle {
  justify-content: space-evenly;
  align-items: center;
  flex: 4;
  margin-top: var(--length-32);
}

.modal_bottom {
  justify-content: space-around;
  align-items: center;
  flex-direction: row;
  flex: 2;
}

.modal_top Label {
  -unity-font-definition: var(--font-bold);
  font-size: var(--length-48);
}

.modal_middle Label {
  font-size: var(--length-32);
  white-space: normal;
  -unity-text-align: upper-center;
}

Label.item_title {
  font-size: var(--length-48);
}

.combat_proficiency_container {
  justify-content: space-evenly;
  align-items: center;
  flex: 1;
  flex-direction: row;
  padding-top: var(--length-8);
  padding-bottom: var(--length-8);
}

.combat_proficiency_container.player {
  border-top-width: var(--length-4);
  border-top-color: var(--color-slate-50);
}

.combat_proficiency_container Label {
  font-size: var(--length-32);
}

.combat_proficiency_container.player Label {
  font-size: var(--length-40);
}