--- !u!114 &7594184514648785313
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3882272147560746744}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0abf080a48149b84fadd3d6654e1c449, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _dialogue:
  - "You\u2019re up late again, Lyra."
  - "So are you. Let me guess\u2014\u201Ca dull sword can\u2019t protect anyone\u201D?"
  - "(Smirks) It\u2019s true. Someone has to stay prepared."
  - And someone has to remind you to rest. Even steel breaks if pushed too hard.
  - "I\u2019ll manage. I always do."
  - "(Smiling softly) You don\u2019t have to do it alone, you know. We\u2019re a
    team."
  - (Looking at her) You really believe that?
  - "I wouldn\u2019t be here if I didn\u2019t."
  - (Pauses) Thanks, Lyra.
  - (Smiling) Anytime. Now, get some sleep before I turn that sword into a plowshare.
  _avatars:
  - {fileID: 21300000, guid: 9ec3e8a441a147048bfa2ee0abcf5dd4, type: 3}
  - {fileID: 21300000, guid: 52c1c78f93de15042b5f535c42304731, type: 3}
  _position: {x: 300, y: 300}
