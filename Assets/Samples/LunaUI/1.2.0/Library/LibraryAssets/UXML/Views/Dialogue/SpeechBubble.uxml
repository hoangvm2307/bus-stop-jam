<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="SpeechBubble.uss?fileID=7433441132597879392&amp;guid=d97add561430b8a4ea8c184e41894911&amp;type=3#SpeechBubble" />
    <ui:VisualElement name="SpeechBubble" class="vn_page">
        <ui:VisualElement class="vn_avatar_parent vn_avatar_parent_left">
            <ui:VisualElement name="AvatarLeftContainer" class="vn_avatar_container">
                <ui:VisualElement name="AvatarLeft" class="vn_avatar" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Button display-tooltip-when-elided="true" name="ContinueButton" class="btn vn_background" focusable="false" >
            <CupkekGames.Luna.InputPrompt enabled="false" icon-image="project://database/Packages/com.cupkekgames.luna/Runtime/Images/Icons/arrow-right-curve.png?fileID=2800000&amp;guid=28789b3231d83414c915ac89623e839f&amp;type=3#arrow-right-curve" name="NextIcon" class="vn_next_icon" />
        </ui:Button>
        <ui:Label enable-rich-text="true" name="Speech" picking-mode="Ignore" text="Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur." class="speech" />
        <ui:VisualElement class="vn_avatar_parent vn_avatar_parent_right">
            <ui:VisualElement name="AvatarRightContainer" class="vn_avatar_container">
                <ui:VisualElement name="AvatarRight" class="vn_avatar" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
