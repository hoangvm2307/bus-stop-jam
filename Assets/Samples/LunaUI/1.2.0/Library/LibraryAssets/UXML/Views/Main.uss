.main_background {
    background-image: url("project://database/Packages/com.cupkekgames.luna/Runtime/Images/Background/Diagonals/DiagonalDiamondPattern2.png?fileID=2800000&guid=77abf2f9ae34eb34fa4c58ad132735e4&type=3#DiagonalDiamondPattern2");
    -unity-background-image-tint-color: var(--color-base-600);
}

.main_button_container_outer {
    width: 48%;
    background-color: rgba(0, 0, 0, 0.9);
    border-right-width: var(--length-12);
    border-left-width: var(--length-12);
    align-self: center;
}

.main_button_container_outer > * {
    max-width: 90%;
}

.main_container {
    border-radius: var(--length-20);
    width: 80%;
}

.main_title {
    -unity-font-definition: var(--font-bold);
    -unity-text-align: upper-center;
    font-size: var(--length-96);
    color: var(--color-base-50);
    height: 30%;
    transition-timing-function: ease-out;
    transition-duration: 0.8s;
    transition-property: all;
    scale: 1;
    justify-content: center;
}

.main_title.animation {
    scale: 0;
}

.main_button_container {
    margin-left: var(--length-20);
    margin-right: var(--length-20);
    transition-timing-function: ease-out;
    transition-duration: 0.8s;
    transition-property: all;
    scale: 1;
}

.main_button_container.animation {
    scale: 0;
}

.main_button_container > Button {
    margin-top: var(--length-6);
    margin-bottom: var(--length-6);
}

.main_button_container > Button > Label {
    margin-left: var(--length-8);
}

.main_bottom_container {
    flex-direction: row;
    position: absolute;
    bottom: 2%;
    right: 2%;
    transition-timing-function: ease-out;
    transition-duration: 0.8s;
    transition-property: all;
    scale: 1;
}

.main_bottom_container.animation {
    scale: 0;
}
