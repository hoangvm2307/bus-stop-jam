Label {
  font-size: var(--length-40);
  margin-left: var(--length-8);
}

.autosave {
  position: absolute;
  right: 0;
  bottom: var(--length-8);
  transition-timing-function: ease-in-out-back;
  transition-duration: 0.6s;
  transition-property: translate;
  translate: 110% 0;
  flex-direction: row; 
  align-items: center;
}

.autosave.show {
  translate: 0 0;
}

.radial-loading {
    --radial-loading-track-color: #fff;
    --radial-loading-line-color: var(--color-primary-800);
}