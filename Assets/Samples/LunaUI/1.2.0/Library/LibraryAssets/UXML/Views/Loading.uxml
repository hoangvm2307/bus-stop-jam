<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="Loading.uss" />
    <engine:VisualElement name="LoadingMask" class="loading_mask" style="flex-grow: 1;">
        <engine:VisualElement class="tint-primary-400 loading-bg" style="justify-content: flex-end; align-content: center; align-items: center;">
            <engine:VisualElement class="w-full" style="flex-direction: row; justify-content: flex-start;">
                <engine:VisualElement name="TipsContainer" picking-mode="Ignore" class="vn_container">
                    <CupkekGames.Luna.InputPrompt enabled="false" label-text="Next Tip" name="InputPromptNextTip" input-action-name="Loading/Action" auto-bind="false" class="next-tip" />
                    <engine:VisualElement name="Body" picking-mode="Ignore" class="vn_body">
                        <engine:Label enable-rich-text="true" name="Speech" picking-mode="Ignore" text="Tip: asjldhqjldhqwdqwd" />
                    </engine:VisualElement>
                </engine:VisualElement>
            </engine:VisualElement>
        </engine:VisualElement>
        <engine:VisualElement name="LoadingPage" class="tint-primary-400 loading-page" style="justify-content: flex-end; align-content: center; align-items: flex-end;">
            <engine:VisualElement name="LoadingContainer" class="loading-container">
                <CupkekGames.Luna.RadialLoading arc-size="0.2" progress="0.53" update-frequency="10" step="0.015" line-width="12" class="size-56" />
                <engine:Label text="Loading..." />
            </engine:VisualElement>
        </engine:VisualElement>
        <engine:VisualElement name="LoadingPage" class="tint-primary-400 loading-page" style="justify-content: flex-end; align-content: center; align-items: flex-end;">
            <engine:VisualElement name="ContinueContainer" class="continue" style="flex-direction: row; align-items: center;">
                <engine:Label text="Press" />
                <CupkekGames.Luna.InputPrompt enabled="false" label-text="to continue" name="InputPromptContinue" input-action-name="Loading/Submit" auto-bind="false" min-size="64" />
            </engine:VisualElement>
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
