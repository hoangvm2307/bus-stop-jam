/* MyMainMenu.uss */

/* Container chính, căn giữa mọi thứ theo cả chiều dọc và ngang */
.main-menu-container {
    flex-grow: 1; /* Cho phép container chiếm hết không gian có sẵn */
    justify-content: center; /* Căn giữa theo chiều dọc */
    align-items: center; /* Căn giữa theo chiều ngang */

    /* Thêm một chút màu nền tối để dễ nhìn */
    background-color: rgb(30, 30, 30);
}

/* Style cho tiêu đề game */
.title {
    font-size: 80px;
    -unity-font-style: bold;
    color: white;
    margin-bottom: 50px;
}

/* Style cho nhóm nút */
.button-group {
    align-items: center; /* Đảm bảo các nút bên trong được căn giữa */
}

/* Style chung cho tất cả các nút trong menu */
.menu-button {
    width: 350px; /* Độ rộng của nút */
    padding: 15px; /* Khoảng đệm bên trong nút */
    margin: 10px 0; /* Khoảng cách giữa các nút */
    font-size: 32px;
    -unity-font-style: bold;
    
    /* Bỏ viền mặc định của Unity */
    border-width: 0;
    border-radius: 15px;

    /* Màu sắc */
    background-color: rgb(75, 75, 75);
    color: white;

    /* Hiệu ứng chuyển động mượt mà */
    transition-duration: 0.15s;
}

/* Style khi người dùng di chuột vào nút */
.menu-button:hover {
    background-color: rgb(110, 110, 110);
    scale: 1.05 1.05; /* Phóng to nhẹ để tạo cảm giác tương tác */
}

/* Style khi nút được chọn (ví dụ: bằng tay cầm) */
.menu-button:focus {
    background-color: rgb(90, 90, 90);
    border-width: 3px;
    border-color: rgb(0, 150, 255);
}